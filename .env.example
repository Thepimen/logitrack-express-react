# ============================================================================
# LogiTrack Express v3.0 — Variables de Entorno (.env.example)
# ============================================================================
# Copia este archivo como `.env` y rellena tus credenciales reales de Supabase.
# NUNCA subas el archivo `.env` a Git ni al paquete .zip de entrega.
# ============================================================================

# 1. Base de Datos Relacional Cloud — Supabase PostgreSQL (eu-west-3)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_KEY=tu_clave_publica_anon_de_supabase

# 2. AWS Cloud Emulator (LocalStack v3.8 / Node Emulator en puerto 4566)
VITE_AWS_EMULATOR_ENDPOINT=http://localhost:4566
VITE_AWS_REGION=eu-west-3
VITE_AWS_DYNAMODB_TABLE=LogiTrackPackages
VITE_AWS_S3_BUCKET=logitrack-manifests-eu-west-3
VITE_AWS_SQS_QUEUE=logitrack-inspection-events
